# ------------------------------------------------------------------
# Copy to `.env.local` for development (gitignored) or configure in
# the hosting dashboard. NEVER commit real secrets — this file holds
# no values on purpose. See docs/GOOGLE.md and docs/SUPABASE.md.
# ------------------------------------------------------------------

# --- Public site ---------------------------------------------------
# Absolute origin of the site, no trailing slash.
# Used for canonical URLs, sitemap.xml, Open Graph tags.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Override site mode: "development" | "production".
# Defaults to NODE_ENV. Use "production" to preview the production view locally.
# NEXT_PUBLIC_SITE_MODE=development

# Enables the Content-Security-Policy header described in docs/GOOGLE.md.
# Opt-in because dev and each integration need different sources.
# NEXT_PUBLIC_SECURITY_HEADERS_CSP=1

# --- Google (all optional, all off by default) ----------------------
# GA4 measurement ID (G-...). Ignored when NEXT_PUBLIC_GTM_ID is set.
# NEXT_PUBLIC_GA4_ID=
# Tag Manager container (GTM-...). If set, keep GA4 tags inside the container.
# NEXT_PUBLIC_GTM_ID=
# Google Search Console verification token for the <meta> tag.
# NEXT_PUBLIC_GSC_VERIFICATION=
# Google Maps "Embed a map" URL for the contact section.
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# --- Admin dashboard ------------------------------------------------
# "false" disables the dashboard entirely (same as unset in production).
# ADMIN_ENABLED=true
# Production access token. Production requires it; development stays open.
# ADMIN_TOKEN=

# --- Supabase backend (optional, see docs/SUPABASE.md) ---------------
# Server-only. Both must be set for booking submissions to be transmitted.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Alternative public URL for the same project; the service-role key above
# stays server-side in every case.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Optional: allow last-known-good local reads when Supabase is unreachable.
# Development always falls back; production serves a 503 instead of stale
# content unless this is set to 1.
# SUPABASE_FALLBACK_TO_LOCAL=1
